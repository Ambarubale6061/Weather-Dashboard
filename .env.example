# Copy to .env and fill in your API / Firebase keys (DO NOT commit real keys)
VITE_OPENWEATHERMAP_KEY=your_openweathermap_api_key_here
VITE_OPENWEATHERMAP_BASE=https://api.openweathermap.org/data/2.5

# Firebase web config (only necessary if you want Google Sign-In)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_app_id
